{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg_main": "none",
    "bg_panel": "#1a1b26",
    "bg_element": "#1f2137",
    "bg_input": "#24263b",
    "fg_main": "#c0caf5",
    "fg_muted": "#565f89",
    "fg_dim": "#3b4261",
    "blue": "#7aa2f7",
    "cyan": "#7dcfff",
    "green": "#9ece6a",
    "red": "#f7768e",
    "yellow": "#e0af68",
    "orange": "#ff9e64",
    "purple": "#bb9af7",
    "teal": "#1abc9c"
  },
  "theme": {
    "primary": { "dark": "blue", "light": "blue" },
    "secondary": { "dark": "cyan", "light": "cyan" },
    "accent": { "dark": "green", "light": "green" },
    "error": { "dark": "red", "light": "red" },
    "warning": { "dark": "orange", "light": "orange" },
    "success": { "dark": "green", "light": "green" },
    "info": { "dark": "blue", "light": "blue" },
    "text": { "dark": "fg_main", "light": "fg_main" },
    "textMuted": { "dark": "fg_muted", "light": "fg_muted" },
    "background": { "dark": "bg_main", "light": "bg_main" },
    "backgroundPanel": { "dark": "bg_panel", "light": "bg_panel" },
    "backgroundElement": { "dark": "bg_element", "light": "bg_element" },
    "border": { "dark": "fg_dim", "light": "fg_dim" },
    "borderActive": { "dark": "blue", "light": "blue" },
    "borderSubtle": { "dark": "fg_dim", "light": "fg_dim" },
    "diffAdded": { "dark": "green", "light": "green" },
    "diffRemoved": { "dark": "red", "light": "red" },
    "diffContext": { "dark": "fg_muted", "light": "fg_muted" },
    "diffHunkHeader": { "dark": "fg_dim", "light": "fg_dim" },
    "diffHighlightAdded": { "dark": "green", "light": "green" },
    "diffHighlightRemoved": { "dark": "red", "light": "red" },
    "diffAddedBg": { "dark": "bg_element", "light": "bg_element" },
    "diffRemovedBg": { "dark": "bg_element", "light": "bg_element" },
    "diffContextBg": { "dark": "bg_panel", "light": "bg_panel" },
    "diffLineNumber": { "dark": "fg_dim", "light": "fg_dim" },
    "diffAddedLineNumberBg": { "dark": "bg_element", "light": "bg_element" },
    "diffRemovedLineNumberBg": { "dark": "bg_element", "light": "bg_element" },
    "markdownText": { "dark": "fg_main", "light": "fg_main" },
    "markdownHeading": { "dark": "blue", "light": "blue" },
    "markdownLink": { "dark": "cyan", "light": "cyan" },
    "markdownLinkText": { "dark": "teal", "light": "teal" },
    "markdownCode": { "dark": "green", "light": "green" },
    "markdownBlockQuote": { "dark": "fg_muted", "light": "fg_muted" },
    "markdownEmph": { "dark": "orange", "light": "orange" },
    "markdownStrong": { "dark": "yellow", "light": "yellow" },
    "markdownHorizontalRule": { "dark": "fg_dim", "light": "fg_dim" },
    "markdownListItem": { "dark": "blue", "light": "blue" },
    "markdownListEnumeration": { "dark": "cyan", "light": "cyan" },
    "markdownImage": { "dark": "purple", "light": "purple" },
    "markdownImageText": { "dark": "fg_muted", "light": "fg_muted" },
    "markdownCodeBlock": { "dark": "fg_main", "light": "fg_main" },
    "syntaxComment": { "dark": "fg_muted", "light": "fg_muted" },
    "syntaxKeyword": { "dark": "purple", "light": "purple" },
    "syntaxFunction": { "dark": "blue", "light": "blue" },
    "syntaxVariable": { "dark": "orange", "light": "orange" },
    "syntaxString": { "dark": "green", "light": "green" },
    "syntaxNumber": { "dark": "orange", "light": "orange" },
    "syntaxType": { "dark": "yellow", "light": "yellow" },
    "syntaxOperator": { "dark": "cyan", "light": "cyan" },
    "syntaxPunctuation": { "dark": "fg_main", "light": "fg_main" }
  }
}