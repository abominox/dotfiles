{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "plugin": ["./plugins/context-mode-v2"],
  "websearch": {
    "provider": "exa"
  },
  // Crowbot: put the 16-digit account number in ~/.config/opencode/crowbot-key (chmod 600).
  "providers": {
    "crowbot": {
      "name": "Crowbot",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.crowbot.sh/v1",
        "apiKey": "{file:~/.config/opencode/crowbot-key}"
      },
      "compatibility": {
        "reasoningField": "reasoning_content"
      },
      "models": {
        "crow-2": {
          "name": "GLM 5.3 [UNCENSORED]",
          "limit": { "context": 1000000, "output": 32768 },
          "cost": { "input": 3.5, "output": 5, "cache": { "read": 0.5 } },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "temperature": true,
            "reasoning": { "supported": true, "effort": ["low", "medium", "high", "xhigh", "max"] }
          }
        },
        "glm-5.3": {
          "name": "GLM 5.3 [Cyber] [UNCENSORED]",
          "limit": { "context": 1000000, "output": 131072 },
          "cost": { "input": 1.35, "output": 4, "cache": { "read": 0.25 } },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "temperature": true,
            "reasoning": { "supported": true, "effort": ["low", "medium", "high", "xhigh", "max"] }
          }
        },
        "glm-5.3-flash-crow": {
          "name": "GLM 5.3 Flash [UNCENSORED]",
          "limit": { "context": 1048576, "output": 32768 },
          "cost": { "input": 0.2, "output": 0.6, "cache": { "read": 0.1 } },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "temperature": true,
            "reasoning": { "supported": true, "effort": ["low", "medium", "high", "xhigh", "max"] }
          }
        },
        "glm-5.3-cheap": {
          "name": "GLM 5.3 [CHEAP]",
          "limit": { "context": 1048576, "output": 128000 },
          "cost": { "input": 0.0947, "output": 0.2975, "cache": { "read": 0.0176 } },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "temperature": true,
            "reasoning": { "supported": true, "effort": ["low", "medium", "high", "xhigh", "max"] }
          }
        },
        "gpt-6.1-sol": {
          "name": "GPT 6.1 Sol",
          "limit": { "context": 1048576, "output": 128000 },
          "cost": { "input": 0.16, "output": 0.8, "cache": { "read": 0.008 } },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "temperature": true,
            "reasoning": { "supported": true, "effort": ["low", "medium", "high", "xhigh", "max"] }
          }
        },
        "claude-opus-5-5": {
          "name": "Claude Opus 5.5",
          "limit": { "context": 1048576, "output": 128000 },
          "cost": { "input": 0.68, "output": 3.4, "cache": { "read": 0.034 } },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "temperature": true,
            "reasoning": { "supported": false }
          }
        },
        "kimi-k3.1-pro-crow": {
          "name": "Kimi K3.1 Pro [UNCENSORED]",
          "limit": { "context": 1048576, "output": 32768 },
          "cost": { "input": 6.25, "output": 15, "cache": { "read": 0.625 } },
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "temperature": true,
            "reasoning": { "supported": true, "effort": ["low", "medium", "high", "xhigh", "max"] }
          }
        },
        "kimi-k3.1-pro": {
          "name": "Kimi K3.1 Pro",
          "limit": { "context": 1048576, "output": 1048576 },
          "cost": { "input": 0.2346, "output": 1.173, "cache": { "read": 0.0235 } },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "temperature": true,
            "reasoning": { "supported": true, "effort": ["low", "medium", "high", "xhigh", "max"] }
          }
        },
        "deepseek-v4.1-flash-1017-crow": {
          "name": "DeepSeek V4.1 Flash 1017 [UNCENSORED]",
          "limit": { "context": 1000000, "output": 32768 },
          "cost": { "input": 0.35, "output": 1.5, "cache": { "read": 0.02 } },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "temperature": true,
            "reasoning": { "supported": true, "effort": ["low", "medium", "high", "xhigh", "max"] }
          }
        },
        "deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash 1017 [CHEAP]",
          "limit": { "context": 1048576, "output": 128000 },
          "cost": { "input": 0.0285, "output": 0.114, "cache": { "read": 0.0006 } },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "temperature": true,
            "reasoning": { "supported": true, "effort": ["low", "medium", "high", "xhigh", "max"] }
          }
        },
        "odin": {
          "name": "Odin [UNCENSORED]",
          "limit": { "context": 1048576, "output": 32768 },
          "cost": { "input": 0.6, "output": 1.8, "cache": { "read": 0.012 } },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "temperature": true,
            "reasoning": { "supported": true, "effort": ["low", "medium", "high", "xhigh", "max"] }
          }
        },
        "odin-ln": {
          "name": "Odin Lightning",
          "limit": { "context": 1048576, "output": 32768 },
          "cost": { "input": 1.2, "output": 3, "cache": { "read": 0.075 } },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "temperature": true,
            "reasoning": { "supported": true, "effort": ["low", "medium", "high", "xhigh", "max"] }
          }
        },
        "odin-cheap": {
          "name": "Odin [CHEAP]",
          "limit": { "context": 1048576, "output": 128000 },
          "cost": { "input": 0.05, "output": 0.25, "cache": { "read": 0.005 } },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "temperature": true,
            "reasoning": { "supported": true, "effort": ["low", "medium", "high", "xhigh", "max"] }
          }
        }
      }
    }
  },
  "mcp": {
    // Startup budget for the initial initialize handshake. Servers launched via
    // npx/uvx used to blow the 30s default whenever the machine slept mid-spawn.
    "timeout": { "startup": 60000 },
    "open-computer-use": {
      "type": "local",
      "command": ["open-computer-use", "mcp"]
    },
    "mcp-obsidian": {
      "type": "local",
      "command": ["/Users/raxemremy/.local/bin/mcp-obsidian-wrapper"]
    },
    "servers": {
      "mtg": {
        "type": "local",
        // pre-installed with: uv tool install --with 'selectolax<1' mtg-mcp-server
        "command": ["/Users/raxemremy/.local/bin/mtg-mcp-server"]
      },
      "playwright": {
        "type": "local",
        // pre-installed with: npm i -g @playwright/mcp
        "command": ["/Users/raxemremy/.npm-global/bin/playwright-mcp"]
      },
      "context7": {
        "type": "local",
        // pre-installed with: npm i -g @upstash/context7-mcp
        "command": ["/Users/raxemremy/.npm-global/bin/context7-mcp"]
      },
      "rea": {
        "type": "local",
        // pre-installed with: npm i -g rea-agents@6.4.0
        "command": [
          "/Users/raxemremy/.npm-global/bin/rea",
          "mcp"
        ],
        "environment": {
          "GHIDRA_INSTALL_DIR": "/opt/homebrew/opt/ghidra/libexec",
          "JAVA_HOME": "/opt/homebrew/Cellar/openjdk@21/21.0.12.1/libexec/openjdk.jdk/Contents/Home"
        }
      },
      "browse": {
        "type": "local",
        "command": [
          "/home/raxemremy/.local/bin/browse",
          "mcp"
        ],
        "cwd": "/home/raxemremy",
        "pool": true,
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update"
        }
      }
    }
  }
}
