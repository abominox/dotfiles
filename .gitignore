scripts/systat_macos

# tmux plugins (not tracked)
.tmux/

# vim plugins (fetched by vim-plug, not tracked)
.vim/bundle/

# vim netrw history (machine-local, regenerates)
.vim/.netrwhist

# Claude Code machine-local settings
.claude/settings.local.json

# Python bytecode (pi web-requests skill)
__pycache__/
*.pyc

# macOS
.DS_Store
