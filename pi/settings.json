{
  "lastChangelogVersion": "0.84.1",
  "defaultProvider": "openrouter",
  "defaultModel": "~deepseek/deepseek-v4-flash-latest",
  "defaultThinkingLevel": "high",
  "terminal": {
    "showTerminalProgress": true
  },
  "hideThinkingBlock": false,
  "packages": [
    "npm:pi-wierd-statusline",
    {
      "source": "git:github.com/tmustier/pi-extensions",
      "extensions": [
        "!files-widget/**",
        "!arcade/**"
      ]
    },
    "git:github.com/DietrichGebert/ponytail",
    "npm:pi-qq",
    "npm:pi-tool-display",
    "npm:pi-subagents",
    "npm:pi-intercom",
    "npm:pi-simplify",
    "npm:@juicesharp/rpiv-ask-user-question",
	"npm:@ff-labs/pi-fff",
    "npm:context-mode",
    "npm:pi-mcp-adapter",
    "npm:@quintinshaw/pi-dynamic-workflows",
    "npm:@juicesharp/rpiv-todo"
  ],
  "extensions": [
    "./extensions/plan-mode"
  ],
  "theme": "dark",
  "editorPaddingX": 2,
  "quietStartup": true,
  "enableInstallTelemetry": false,
  "collapseChangelog": false,
  "doubleEscapeAction": "tree",
  "steeringMode": "all",
  "flags": {
    "--recap-model": "openrouter/google/gemini-2.5-flash"
  },
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "openrouter/deepseek/deepseek-v4-flash-latest",
        "thinking": "off"
      },
      "researcher": {
        "model": "openrouter/deepseek/deepseek-v4-flash-latest",
        "thinking": "off",
        "tools": [
          "read",
          "write",
          "bash",
          "ctx_fetch_and_index",
          "ctx_search",
          "ctx_index",
          "intercom"
        ],
        "inheritSkills": true,
        "systemPrompt": "You are a research subagent. Use `ketch search`, `ketch scrape`, and `ketch docs` (via bash) for web searches and page fetching. Use `ctx_fetch_and_index` for fetching pages into the knowledge base, then `ctx_search` to query indexed content. Prefer primary sources and official docs. Produce a concise research brief in research.md. Gaps and sources required."
      },
      "planner": {
        "model": "openrouter/deepseek/deepseek-v4-flash-latest",
        "thinking": "off"
      },
      "worker": {
        "model": "openrouter/deepseek/deepseek-v4-flash-latest",
        "thinking": "off"
      },
      "reviewer": {
        "model": "openrouter/deepseek/deepseek-v4-flash-latest",
        "thinking": "off"
      },
      "oracle": {
        "model": "openrouter/deepseek/deepseek-v4-flash-latest",
        "thinking": "off"
      },
      "context-builder": {
        "model": "openrouter/deepseek/deepseek-v4-flash-latest",
        "thinking": "off"
      },
      "delegate": {
        "model": "openrouter/deepseek/deepseek-v4-flash-latest",
        "thinking": "off"
      }
    },
    "watchdog": {
      "children": {
        "model": "openrouter/deepseek/deepseek-v4-flash-latest"
      }
    }
  },
  "enabledModels": [
    "openrouter/z-ai/glm-5.2",
    "openrouter/~deepseek/deepseek-v4-flash-latest"
  ]
}
